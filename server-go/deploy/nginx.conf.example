# 宿主机 nginx 反向代理示例：nginx 负责 HTTPS（Let's Encrypt），转发到本机的 NextReply 服务。
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/nextreply   # 把 api.example.com 换成你的域名
#   sudo ln -s /etc/nginx/sites-available/nextreply /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.example.com      # 申请证书并自动改写本文件，之后自动续期
#
# .env 中设置 CLIENT_IP_HEADER=X-Real-IP，BIND_ADDR 保持默认 127.0.0.1。

server {
    listen 80;
    server_name api.example.com;

    # 截图 base64 后最大约 6MB
    client_max_body_size 8m;

    # 隐私：nginx 默认会把较大的请求体写进磁盘临时文件，截图会因此落盘。
    # 关闭请求缓冲后请求体直接流式转发给服务，不经过磁盘。
    proxy_request_buffering off;

    # 结账 / 管理订阅链接的 URL 里带有一次性票据，不记录访问日志
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 覆盖客户端可能自带的同名请求头，服务按它做按 IP 的限额
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 模型调用最长约 50 秒（含一次重试）
        proxy_read_timeout 90s;
    }
}
