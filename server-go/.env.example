# ===== 必填 =====

# 对外域名（Caddy 用它自动申请 HTTPS 证书）。本地试用可以写 localhost
DOMAIN=api.example.com
# 对外地址，用于生成登录 / 结账链接，必须和 DOMAIN 对应
PUBLIC_URL=https://api.example.com

ANTHROPIC_API_KEY=sk-ant-...
# 签发设备 token 和登录令牌的密钥，至少 32 个字符：openssl rand -base64 48
# 从旧版 Workers 服务迁移时沿用原来的值，已发出的设备 token 继续有效
TOKEN_SECRET=

# 登录验证码邮件（Resend）。DEV_MODE=false 时必填
RESEND_API_KEY=re_...
EMAIL_FROM=NextReply <noreply@example.com>

# ===== 模型（可选，默认值如下） =====
# MODEL=claude-opus-5-5
# EFFORT=low
# THINKING=auto
# FALLBACKS=default
# MAX_TOKENS=8000

# ===== 限额（可选） =====
# 同一 IP 每天最多成功回复次数
# IP_DAILY_QUOTA=200
# 同一 IP 每天最多注册的新设备数
# REGISTER_PER_IP=20

# ===== 注册人机验证（可选，Cloudflare Turnstile） =====
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# ===== 订阅支付（可选，Stripe） =====
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PRO_PLUS=price_...

# ===== 开发调试（线上必须保持 false） =====
# true：没配邮件时验证码直接显示在登录页；没配 Stripe 时提供模拟支付
DEV_MODE=false
# true（且 DEV_MODE=true）：不调用模型，返回固定结果
# MOCK_AI=false

# 国内服务器构建镜像时可以换成 https://goproxy.cn,direct
# GOPROXY=https://proxy.golang.org,direct
