# ===== 必填 =====

# 对外地址，用于生成登录 / 结账链接；桌面端的服务端地址也填这个
# 测试机：http://<机器 IP>:8787
PUBLIC_URL=https://api.example.com

ANTHROPIC_API_KEY=sk-ant-...
# 签发设备 token 和登录令牌的密钥，至少 32 个字符：openssl rand -base64 48
# 从旧版 Workers 服务迁移时沿用原来的值，已发出的设备 token 继续有效
TOKEN_SECRET=

# 登录验证码邮件（Resend）。DEV_MODE=false 时必填
RESEND_API_KEY=re_...
EMAIL_FROM=NextReply <noreply@example.com>

# ===== 网络（见 README「HTTPS」） =====
# 服务只提供 HTTP。宿主机上监听的地址和端口，默认只对本机开放（127.0.0.1:8787）
#   生产（Cloudflare Tunnel / nginx 在本机转发）：保持默认
#   测试机（局域网直接访问）：BIND_ADDR=0.0.0.0
# BIND_ADDR=127.0.0.1
# PORT=8787
# 从哪个请求头读取客户端真实 IP：
#   Cloudflare Tunnel：CF-Connecting-IP
#   nginx：            X-Real-IP
#   测试机直连：       留空
# 只有在请求一定经过会覆盖该请求头的代理时才能设置，否则客户端可以伪造
# CLIENT_IP_HEADER=

# ===== 管理后台（可选） =====
# 设置后启动后台（宿主机 127.0.0.1:8788），浏览器登录用户名 admin、密码为此值；至少 24 个字符
# ADMIN_TOKEN=
# 页面时间显示的时区
# ADMIN_TZ=Asia/Shanghai
# ADMIN_PORT=8788

# ===== 模型（可选，默认值如下） =====
# 付费用户（pro / pro_plus）
# MODEL=claude-opus-5-5
# EFFORT=low
# 免费用户（trial 匿名体验 + free 已登录未订阅），默认用更便宜的模型
# MODEL_FREE=claude-sonnet-5
# EFFORT_FREE=low
# 单个套餐覆盖（优先级最高）：MODEL_TRIAL / MODEL_FREE / MODEL_PRO / MODEL_PRO_PLUS，EFFORT_ 同理
# MODEL_TRIAL=claude-haiku-4-5
# THINKING=auto
# FALLBACKS=default
# MAX_TOKENS=8000

# ===== 限额（可选） =====
# 同一 IP 每天最多成功回复次数
# IP_DAILY_QUOTA=200
# 同一 IP 每天最多注册的新设备数
# REGISTER_PER_IP=20

# ===== 注册人机验证（可选，Cloudflare Turnstile） =====
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# ===== 订阅支付（可选，Stripe） =====
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PRO_PLUS=price_...

# ===== 开发调试（线上必须保持 false） =====
# true：没配邮件时验证码直接显示在登录页；没配 Stripe 时提供模拟支付
DEV_MODE=false
# true（且 DEV_MODE=true）：不调用模型，返回固定结果
# MOCK_AI=false

# 国内服务器构建镜像时可以换成 https://goproxy.cn,direct
# GOPROXY=https://proxy.golang.org,direct
