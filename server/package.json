{
  "name": "nextreply-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev:mock": "wrangler dev --ip 127.0.0.1 --port 8787 --var MOCK_AI:true",
    "test:e2e": "node scripts/e2e-account.mjs",
    "reset:limits": "node scripts/reset-local-limits.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "hono": "^4.13.13",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
